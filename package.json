{
  "name": "one-grain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One Grain: a scroll-driven WebGL story of a single grain of sand.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "prepare": "node scripts/setup-hooks.mjs",
    "parity": "vite build && node scripts/parity.mjs",
    "check:console": "vite build && node scripts/console-gate.mjs",
    "check:data": "node scripts/data-gate.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "perf": "vite build && node scripts/perf.mjs",
    "perf:frame": "vite build --minify false && node scripts/frame-cost.mjs",
    "check:text": "node scripts/text-parity.mjs",
    "check:reverse": "node scripts/reverse-scrub.mjs",
    "check:seams": "node scripts/seams.mjs",
    "check:fonts": "vite build && node scripts/fonts-check.mjs",
    "check:tiers": "node scripts/tier-check.mjs",
    "check:audio": "node scripts/audio-check.mjs",
    "responsive": "vite build && node scripts/responsive.mjs",
    "check:responsive": "node scripts/responsive-check.mjs",
    "check:load": "node scripts/load-check.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "capture": "node scripts/capture.mjs",
    "encode": "node scripts/encode.mjs",
    "icons": "node scripts/icons.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
